mutate(study = ifelse(total <= 144, 2, 1))
if(temp.df$loglikTotal %>% unique() > max12) {
max12 = temp.df$loglikTotal %>% unique()
best.fit.12.df = temp.df
best.fit.12.filename = filename
vision12 = a
sensory12 = b
window12 = c
spatial12 = d
}
if((temp.df %>% filter(study == 1))$loglik %>% unique() > max1) {
max1 = (temp.df %>% filter(study == 1))$loglik %>% unique()
best.fit.1.df = temp.df
