# don't need for sherlock
library("knitr") # for rmd
library("ggplot2") # for generating plots
# need for sherlock
library("rwebppl") # for webppl probabalistic programming
library("dplyr") # for pipes
library("broom") # for tidy
library("stringr") # str_c
library("caret")
# Installing Webppl
# install.packages('devtools') # needed to install rwebppl
# devtools::install_github("mhtess/rwebppl")
theme_set(theme_classic() +
theme(text = element_text(size = 10)))
opts_chunk$set(comment = "#>",
fig.show = "hold")
options(dplyr.summarise.inform = F)
# for similarity of colors
unPalette = c('#E62121', '#3A88E0', '#F7D027', '#68C16A', '#A121C1')
sensePalette <- c('#4E4E4E', unPalette[3], unPalette[4], unPalette[5])
signalPalette = c("#003f5c", "#7a5195", "#ef5675", "#ffa600")
newBlue = "#349CE9"
newLightGreen = "#A6D12E"
realismPalette = c(newLightGreen, newBlue)
# '#5AAEAB'
cueInfoPalette = c(newLightGreen, '#36716F', newBlue)
## Labels
offset.labs <- c("0 ms", "100 ms", "200 ms", "300 ms", "400 ms")
names(offset.labs) <- c("0", "100", "200", "300", "400")
# exp12_file = "modelResults_r14/exp12_run_38_n_70_170_w_250_p_1_1_s_1.25.csv"
exp12_file = "modelResults_r15/exp12_run_255_n_70_210_w_240_p_1_1_s_1.25.csv"
# exp12_file = "modelResults_l1/exp12_run_43_n_80_240_w_1_p_1_1_s_1.csv"
# exp12_file = "modelResults_l2/exp12_run_45_n_90_150_w_1000_p_1_1_s_2.csv"
exp12.df = read.csv(exp12_file, header = TRUE) %>%
mutate(study = ifelse(total <= 144, 2, 1))
slope.exp12 = exp12.df$slope %>% unique()
intercept.exp12 = exp12.df$intercept %>% unique()
exp1.df = read.csv("humanData/exp1.csv", header = TRUE) %>% select(-X) %>%
mutate(study = 1)
exp2.df = read.csv("humanData/exp2.csv", header = TRUE) %>% select(-X) %>%
mutate(study = 2)
# plot all data
exp.1.plot = ggplot(exp12.df %>% filter(study == 1),
aes(x = offset, y = modelPrediction,
color = as.factor(signals), fill = as.factor(signals))) +
# colors
scale_colour_manual(values=c(signalPalette), guide = "none") +
scale_fill_manual(values=c(signalPalette), guide = "none") +
# # human data
# geom_point(aes(offset, numOnes/(numOnes + numZeros), color = as.factor(signals)),
#            size = 2, alpha = .75) +
# # model predictions
# geom_point(size = 3, shape = 0, alpha = 0.75) +
# human data
stat_summary(data = exp1.df, aes(offset, response, color = as.factor(signals)),
# fun.data = "mean_cl_boot", size = 0.25, alpha = .75) +
fun.data = 'mean_cl_boot', alpha = .65,
size = 0.5, stroke = 0.5, linewidth = 1) +
# model predictions
# stat_summary(fun.data = "mean_cl_boot", size = 0.5, shape = 0, alpha = 0.75) +
stat_summary(geom="point", fun.y = mean, size = 1, shape = 21, alpha = 0.65,
color = "black", stroke = 0.5) +
stat_summary(geom="errorbar", fun.data = mean_cl_boot, width = 0,
size = 0.25, col = "black") +
# coord_cartesian(xlim = c(-100, 600), ylim = c(0, 1)) +
coord_cartesian(xlim = c(-84, 600), ylim = c(0, 1)) +
scale_y_continuous(breaks = seq(0, 1, 0.25)) +
scale_x_continuous(breaks = c(seq(-84,0,42),seq(100,600,100))) +
labs(title = "Experiment 1", x = "Offset (ms)",
y = "Causal Response Rate", color = "# of Signals") +
theme(#legend.title = element_blank(),
text = element_text(size=8),
aspect.ratio = 0.25) #.75
# plot all data
exp.1.facet.plot = ggplot(exp12.df %>% filter(study == 1),
aes(x = as.factor(signals), y = modelPrediction,
color = as.factor(signals), fill = as.factor(signals))) +
# colors
scale_colour_manual(values=c(signalPalette), guide = "none") +
scale_fill_manual(values=c(signalPalette), guide = "none") +
# break up by offset
facet_grid(cols = vars(offset),
labeller = labeller(offset = ~ paste(.x, "ms"))) +
