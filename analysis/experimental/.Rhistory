sensory1 = b
window1 = c
spatial1 = d
}
if((temp.df %>% filter(study == 2))$loglik %>% unique() > max2) {
max2 = (temp.df %>% filter(study == 2))$loglik %>% unique()
best.fit.2.df = temp.df
best.fit.2.filename = filename
vision2 = a
sensory2 = b
window2 = c
spatial2 = d
}
}
}
}
